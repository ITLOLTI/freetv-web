{
  "name": "freetv-mac",
  "productName": "FreeTV",
  "version": "1.2.0",
  "description": "FreeTV for Mac \u2013 IPTV player with recording and downloads",
  "main": "main.cjs",
  "author": "ITLOLTI",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "hls.js": "1.5.17",
    "mpegts.js": "1.7.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.freetv.mac",
    "productName": "FreeTV",
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**",
      "node_modules/ffmpeg-static/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "FreeTV",
      "artifactName": "FreeTV-${version}-${arch}.dmg"
    },
    "asar": false,
    "afterPack": "build/adhoc-sign.cjs"
  }
}